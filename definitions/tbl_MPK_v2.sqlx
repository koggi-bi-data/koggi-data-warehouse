config {
    type: "incremental",
    schema: "BI",
    name: "tbl_MPK_v2_TEST",
    uniqueKey: ["id_mpk"],
    description: "Tabla unificada de Motor de Política de Crédito (MPK) con datos de calculadoras.",
    bigquery: {
        partitionBy: "DATE_TRUNC(fecha_ejecucion, MONTH)",
        clusterBy: ["constructora", "estado"],
        updatePartitionFilter: "fecha_ejecucion >= CURRENT_TIMESTAMP() - INTERVAL 7 DAY"
    }
}

WITH
  CalculatorData AS (
  SELECT
    CAST(document_id AS STRING) AS document_id,
    proyecto,
    constructora,
    nombre,
    id_lead,
    valor_credito,
    valor_inmueble,
    tipo_vivienda,
    calificacion,
    idFamilyGroup
  FROM
    ${ref("firestore_calculator", "Calculator_table_TEST")}
  UNION ALL
  SELECT
    CAST(document_id AS STRING) AS document_id,
    proyecto,
    constructora,
    nombre,
    id_lead,
    valor_credito,
    valor_inmueble,
    tipo_vivienda,
    calificacion,
    idFamilyGroup
  FROM
    ${ref("firestore_collections", "Calculator_table_TEST")} ),
  FamiliarGroups AS (
  SELECT
    DISTINCT principalIdLead
  FROM
    ${ref("tbl_sq_familiar_groups")}
  WHERE
    principalIdLead IS NOT NULL ),
  mpk_parsed AS (
  SELECT
    fecha_ejecucion,
    id_calculadora,
    SAFE_CAST(id_mpk AS INT64) AS id_mpk,
    CAST(idFamilyGroup AS STRING) AS idFamilyGroup,
    FechaCambio,
    response,
    CASE
      WHEN JSON_EXTRACT_SCALAR(response, '$.error') IS NOT NULL THEN 'ERROR'
      ELSE 'EXITOSO'
  END
    AS estado,
    JSON_EXTRACT_SCALAR(response, '$.causales_banco_constructor') AS causales_banco_constructor,
    JSON_EXTRACT_SCALAR(response, '$.causal_no_cumplimiento') AS causal_no_cumplimiento_cruda,
    JSON_EXTRACT_SCALAR(response, '$.cumple_con_banco_constructor') AS cumple_con_banco_constructor,
    JSON_EXTRACT_SCALAR(response, '$.resumen_viabilidad_banco') AS resumen_viabilidad_banco_json,
    -- Columnas para el conteo de bancos
    JSON_EXTRACT_SCALAR(response, '$.aplica_bbva') AS aplica_bbva,
    JSON_EXTRACT_SCALAR(response, '$.aplica_itau') AS aplica_itau,
    JSON_EXTRACT_SCALAR(response, '$.aplica_bancolombia') AS aplica_bancolombia,
    JSON_EXTRACT_SCALAR(response, '$.aplica_occidente') AS aplica_occidente,
    JSON_EXTRACT_SCALAR(response, '$.aplica_caja_social') AS aplica_caja_social,
    JSON_EXTRACT_SCALAR(response, '$.aplica_banco_bogota') AS aplica_banco_bogota,
    JSON_EXTRACT_SCALAR(response, '$.aplica_credifamilia') AS aplica_credifamilia
  FROM
    ${ref("tbl_sq_mpk")} ${when(incremental(), `WHERE FechaCambio >= CURRENT_TIMESTAMP() - INTERVAL 7 DAY`)} ),
  BaseCausalUnificada AS (
  SELECT
    mpk.*,
    calc.proyecto,
    calc.constructora,
    calc.nombre,
    calc.id_lead,
    calc.document_id AS calc_doc_id,
    calc.tipo_vivienda,
    calc.valor_credito,
    calc.valor_inmueble,
    prof.rol,
    lboard.uid_entity,
    dataprojects.delivery_at,
    UPPER(CASE
        WHEN mpk.causales_banco_constructor IS NOT NULL AND TRIM(mpk.causales_banco_constructor) != '' AND UPPER(TRIM(mpk.causales_banco_constructor)) NOT IN ('SIN BANCO CONSTRUCTOR', 'CUMPLE', 'VIABLE') THEN TRIM(mpk.causales_banco_constructor)
        WHEN mpk.causal_no_cumplimiento_cruda IS NOT NULL
      AND TRIM(mpk.causal_no_cumplimiento_cruda) != '' THEN TRIM(mpk.causal_no_cumplimiento_cruda)
        ELSE 'SIN CAUSAL'
    END
      ) AS causal_unificada_cruda,
    CASE
      WHEN mpk.cumple_con_banco_constructor IN ('VIABLE', 'VIABLE EN ANÁLISIS') THEN mpk.cumple_con_banco_constructor
      ELSE 'NO VIABLE'
  END
    AS resumen_viabilidad_banco,
    ( (CASE
          WHEN estado = 'EXITOSO' AND aplica_bbva = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_itau = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_bancolombia = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_occidente = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_caja_social = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_banco_bogota = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_credifamilia = 'APLICA' THEN 1
          ELSE 0
      END
        ) ) AS total_bancos_aplica,
    CASE
      WHEN prof.rol = 'TITULAR' AND mpk.idfamilygroup != '' THEN 'Grupo Familiar'
      WHEN (mpk.idFamilyGroup IS NULL
      OR mpk.idFamilyGroup = '')
    AND prof.rol = 'TITULAR'
    AND fam.principalIdLead IS NULL THEN 'Único Comprador'
      ELSE 'OTRO'
  END
    AS validacion_unidades_vivienda
  FROM
    mpk_parsed AS mpk
  LEFT JOIN
    CalculatorData AS calc
  ON
    mpk.id_calculadora = calc.document_id
  LEFT JOIN
    ${ref("tbl_profiling")} AS prof
  ON
    prof.id = calc.id_lead
  LEFT JOIN
    ${ref("tbl_entity_database")} AS entitydb
  ON
    entitydb.key = calc.constructora
  LEFT JOIN
    ${ref("tbl_looker_board")} AS lboard
  ON
    lboard.entity_id = entitydb.id_entity_database
  LEFT JOIN
    ${ref("tbl_builder_projects")} AS dataprojects
  ON
    LOWER(TRIM(dataprojects.name)) = LOWER(TRIM(calc.proyecto))
  LEFT JOIN
    FamiliarGroups AS fam
  ON
    fam.principalIdLead = calc.id_lead )
SELECT
  * EXCEPT (causal_unificada_cruda,
    causal_no_cumplimiento_cruda,
    response,
    resumen_viabilidad_banco_json,
    aplica_bbva,
    aplica_itau,
    aplica_bancolombia,
    aplica_occidente,
    aplica_caja_social,
    aplica_banco_bogota,
    aplica_credifamilia),
  -- Normalización de causales
  CASE
    WHEN TRIM(causal_no_cumplimiento_cruda) IS NULL OR TRIM(causal_no_cumplimiento_cruda) = '' THEN 'SCORE MENOR AL REQUERIDO'
    WHEN causal_no_cumplimiento_cruda IN ('CAPACIDAD',
    'CAPACIDAD DE ENDEUDAMIENTO',
    'EXCEDE LÍMITE DE CRÉDITO') THEN 'CAPACIDAD DE PAGO'
    WHEN causal_no_cumplimiento_cruda IN ('ENDEUDAMENTO', 'ENDEUDAMIENTO') THEN 'NIVEL DE ENDEUDAMIENTO'
    WHEN causal_no_cumplimiento_cruda IN ('INGRESO',
    'INGRESO FINAL') THEN 'INGRESO INSUFICIENTE'
    WHEN causal_no_cumplimiento_cruda IN ('SCORE', 'SCORE MENOR AL REQUERIDO') THEN 'SCORE MENOR AL REQUERIDO'
    ELSE UPPER(causal_no_cumplimiento_cruda)
END
  AS causal_no_cumplimiento_normalizada,
  CURRENT_DATETIME('America/Bogota') AS fecha_actualizacion_bi
FROM
  BaseCausalUnificada
QUALIFY
  ROW_NUMBER() OVER(PARTITION BY id_mpk ORDER BY FechaCambio DESC) = 1
