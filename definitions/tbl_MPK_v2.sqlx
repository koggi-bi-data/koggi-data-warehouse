config {
    type: "incremental",
    schema: "BI",
    name: "tbl_MPK_v2_TEST",
    tags: ["diario"],
    uniqueKey: ["id_mpk"],
    description: "Tabla unificada de Motor de Política de Crédito (MPK). Versión incremental optimizada.",
    bigquery: {
        partitionBy: "DATE_TRUNC(fecha_ejecucion, MONTH)",
        clusterBy: ["constructora", "estado"]
    }
}

WITH
  CalculatorData AS (
  -- Unificación segura de fuentes de calculadora
  SELECT
    CAST(document_id AS STRING) AS document_id,
    proyecto,
    constructora,
    nombre,
    id_lead,
    valor_credito,
    valor_inmueble,
    tipo_vivienda,
    calificacion,
    idFamilyGroup
  FROM
    ${ref("firestore_calculator", "Calculator_table_TEST")}
  UNION ALL
  SELECT
    CAST(document_id AS STRING) AS document_id,
    proyecto,
    constructora,
    nombre,
    id_lead,
    valor_credito,
    valor_inmueble,
    tipo_vivienda,
    calificacion,
    idFamilyGroup
  FROM
    ${ref("firestore_collections", "Calculator_table_TEST")} ),
  FamiliarGroups AS (
  SELECT
    DISTINCT principalIdLead
  FROM
    ${ref("tbl_sq_familiar_groups")}
  WHERE
    principalIdLead IS NOT NULL ),
  mpk_parsed AS (
  SELECT
    fecha_ejecucion,
    id_calculadora,
    SAFE_CAST(id_mpk AS INT64) AS id_mpk,
    CAST(idFamilyGroup AS STRING) AS idFamilyGroup,
    FechaCambio,
    response,
    CASE
      WHEN JSON_EXTRACT_SCALAR(response, '$.error') IS NOT NULL THEN 'ERROR'
      ELSE 'EXITOSO'
  END
    AS estado,
    JSON_EXTRACT_SCALAR(response, '$.identificacion') AS identificacion,
    JSON_EXTRACT_SCALAR(response, '$.identification_type') AS identification_type,
    SAFE_CAST(JSON_EXTRACT_SCALAR(response, '$.score') AS FLOAT64) AS score,
    SAFE_CAST(JSON_EXTRACT_SCALAR(response, '$.ingresos') AS NUMERIC) AS ingresos,
    JSON_EXTRACT_SCALAR(response, '$.viabilidad') AS viabilidad,
    SAFE_CAST(JSON_EXTRACT_SCALAR(response, '$.cuotas_titular') AS INT64) AS cuotas_titular,
    SAFE_CAST(JSON_EXTRACT_SCALAR(response, '$.endeudamiento_financiero') AS NUMERIC) AS endeudamiento_financiero,
    JSON_EXTRACT_SCALAR(response, '$.viable_pesos_20') AS viable_pesos_20,
    JSON_EXTRACT_SCALAR(response, '$.viable_uvr_20') AS viable_uvr_20,
    JSON_EXTRACT_SCALAR(response, '$.viable_uvr_30') AS viable_uvr_30,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_bbva'), ''), 'NO APLICA') AS aplica_bbva,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_itau'), ''), 'NO APLICA') AS aplica_itau,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_occidente'), ''), 'NO APLICA') AS aplica_occidente,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_bancolombia'), ''), 'NO APLICA') AS aplica_bancolombia,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_caja_social'), ''), 'NO APLICA') AS aplica_caja_social,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_banco_bogota'), ''), 'NO APLICA') AS aplica_banco_bogota,
    IFNULL(NULLIF(JSON_EXTRACT_SCALAR(response, '$.aplica_credifamilia'), ''), 'NO APLICA') AS aplica_credifamilia,
    JSON_EXTRACT_SCALAR(response, '$.necesita_codeudor') AS necesita_codeudor,
    JSON_EXTRACT_SCALAR(response, '$.causal_no_cumplimiento') AS causal_no_cumplimiento_cruda,
    JSON_EXTRACT_SCALAR(response, '$.cumple_con_bancos_koggi') AS cumple_con_bancos_koggi,
    JSON_EXTRACT_SCALAR(response, '$.banco_constructor_nombre') AS banco_constructor_nombre,
    JSON_EXTRACT_SCALAR(response, '$.banco_constructor_nit') AS banco_constructor_nit,
    JSON_EXTRACT_SCALAR(response, '$.causales_banco_constructor') AS causales_banco_constructor,
    JSON_EXTRACT_SCALAR(response, '$.cumple_con_banco_constructor') AS cumple_con_banco_constructor,
    JSON_EXTRACT_SCALAR(response, '$.resumen_viabilidad_banco') AS resumen_viabilidad_banco_json
  FROM
    ${ref("tbl_sq_mpk")} ${when(incremental(), `WHERE fecha_ejecucion >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`)} ),
  BaseCausalUnificada AS (
  SELECT
    mpk.*,
    calc.proyecto,
    calc.constructora,
    calc.nombre,
    calc.id_lead,
    calc.document_id,
    calc.tipo_vivienda,
    calc.valor_credito,
    calc.valor_inmueble,
    prof.email,
    prof.phone,
    prof.id,
    prof.rol,
    prof.qualification,
    lboard.uid_entity,
    dataprojects.delivery_at,
    UPPER(CASE
        WHEN mpk.causales_banco_constructor IS NOT NULL AND TRIM(mpk.causales_banco_constructor) != '' AND UPPER(TRIM(mpk.causales_banco_constructor)) NOT IN ('SIN BANCO CONSTRUCTOR', 'CUMPLE', 'VIABLE') THEN TRIM(mpk.causales_banco_constructor)
        WHEN mpk.causal_no_cumplimiento_cruda IS NOT NULL
      AND TRIM(mpk.causal_no_cumplimiento_cruda) != '' THEN TRIM(mpk.causal_no_cumplimiento_cruda)
        ELSE 'SIN CAUSAL'
    END
      ) AS causal_unificada_cruda,
    CASE
      WHEN mpk.cumple_con_banco_constructor IN ('VIABLE', 'VIABLE EN ANÁLISIS') THEN mpk.cumple_con_banco_constructor
      ELSE 'NO VIABLE'
  END
    AS resumen_viabilidad_banco,
    ( (CASE
          WHEN estado = 'EXITOSO' AND aplica_bbva = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_itau = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_bancolombia = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_occidente = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_caja_social = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_banco_bogota = 'APLICA' THEN 1
          ELSE 0
      END
        ) + (CASE
          WHEN estado = 'EXITOSO' AND aplica_credifamilia = 'APLICA' THEN 1
          ELSE 0
      END
        ) ) AS total_bancos_aplica,
    
    CASE
      WHEN prof.rol = 'TITULAR' AND mpk.idFamilyGroup != '' THEN 'Grupo Familiar'
      WHEN mpk.idFamilyGroup IS NULL AND prof.rol = 'TITULAR' AND fam.principalIdLead IS NULL THEN 'Único Comprador'
      ELSE NULL
  END
    AS validacion_unidades_vivienda
  FROM mpk_parsed AS mpk
  LEFT JOIN CalculatorData AS calc ON mpk.id_calculadora = calc.document_id
  LEFT JOIN ${ref("tbl_profiling")} AS prof ON prof.id = calc.id_lead
  LEFT JOIN ${ref("tbl_entity_database")} AS entitydb ON entitydb.key = calc.constructora
  LEFT JOIN ${ref("tbl_looker_board")} AS lboard ON lboard.entity_id = entitydb.id_entity_database
  LEFT JOIN ${ref("tbl_builder_projects")} AS dataprojects ON LOWER(TRIM(dataprojects.name)) = LOWER(TRIM(calc.proyecto))
  LEFT JOIN FamiliarGroups AS fam ON fam.principalIdLead = calc.id_lead )

SELECT
  * EXCEPT (causal_unificada_cruda, causal_no_cumplimiento_cruda, response, resumen_viabilidad_banco_json),
  UPPER(proyecto) as proyecto_normalizado,

  -- Normalización de causales
  CASE
    WHEN TRIM(causal_no_cumplimiento_cruda) IS NULL OR TRIM(causal_no_cumplimiento_cruda) = '' THEN 'SCORE MENOR AL REQUERIDO'
    WHEN causal_no_cumplimiento_cruda IN ('CAPACIDAD', 'CAPACIDAD DE ENDEUDAMIENTO', 'EXCEDE LÍMITE DE CRÉDITO') THEN 'CAPACIDAD DE PAGO'
    WHEN causal_no_cumplimiento_cruda IN ('ENDEUDAMENTO', 'ENDEUDAMIENTO') THEN 'NIVEL DE ENDEUDAMIENTO'
    WHEN causal_no_cumplimiento_cruda IN ('INGRESO', 'INGRESO FINAL') THEN 'INGRESO INSUFICIENTE'
    WHEN causal_no_cumplimiento_cruda IN ('SCORE', 'SCORE MENOR AL REQUERIDO') THEN 'SCORE MENOR AL REQUERIDO'
    ELSE UPPER(causal_no_cumplimiento_cruda)
  END AS causal_no_cumplimiento,

  CASE
    WHEN causal_unificada_cruda IN ('CAPACIDAD', 'CAPACIDAD DE ENDEUDAMIENTO', 'EXCEDE LÍMITE DE CRÉDITO') THEN 'CAPACIDAD DE PAGO'
    WHEN causal_unificada_cruda IN ('ENDEUDAMENTO', 'ENDEUDAMIENTO') THEN 'NIVEL DE ENDEUDAMIENTO'
    WHEN causal_unificada_cruda IN ('INGRESO', 'INGRESO FINAL') THEN 'INGRESO INSUFICIENTE'
    WHEN causal_unificada_cruda IN ('SCORE', 'SCORE MENOR AL REQUERIDO','SIN CAUSAL') THEN 'SCORE MENOR AL REQUERIDO'
    ELSE causal_unificada_cruda
  END AS causales_banco_constructor_normalizado,

  UPPER(CASE
    WHEN causales_banco_constructor IN ('CUMPLE','ENDEUDAMIENTO','CAPACIDAD','Ocupación') THEN causales_banco_constructor
    WHEN UPPER(causales_banco_constructor) IN ('SCORE') THEN 'SCORE'
    WHEN UPPER(causales_banco_constructor) IN ('INGRESO FINAL','INGRESO') THEN 'INGRESO'
    ELSE 'SIN REGISTRO'
  END) AS causal_banco_constructor_dashboard,

  CASE
   WHEN total_bancos_aplica = 0 and viabilidad = 'CON EXCEPCIONES' THEN 'NO VIABLE'
   WHEN total_bancos_aplica = 1 and viabilidad = 'CON EXCEPCIONES' THEN 'VIABLE EN ANÁLISIS'
   ELSE viabilidad
  END AS viabilidad_general_koggi_dashboard,

  DATETIME(CURRENT_TIMESTAMP(), "America/Bogota") as ultima_actualizacion

FROM BaseCausalUnificada
WHERE validacion_unidades_vivienda IS NOT NULL 
AND estado = 'EXITOSO' 
QUALIFY ROW_NUMBER() OVER(PARTITION BY id_mpk ORDER BY FechaCambio DESC) = 1