config {
  type: "incremental",
  schema: "BI",
  name: "profiling_dashboard_quick_win",
  tags: ["dashboard", "diario"],
  uniqueKey: ["lead_id"],
  description: "Tabla consolidada incremental con lógica de deduplicación y campos en parejas (Individual/Familiar).",
  bigquery: {
    partitionBy: "DATE(Fecha_creacion)",
    updatePartitionFilter: "Fecha_creacion >= CURRENT_DATE() - 3"
  }
}

WITH
-- 1. Staging de Profiling
stg_profiling AS (
  SELECT
    id AS lead_id,
    createdAt as Fecha_creacion,
    fullname,
    builderKey as Constructora,
    identification,
    gender,
    venta_efectiva,
    createdEmail,
    qualification AS calificacion_sugerida,
    ACTIVIDAD_ECONOMICA AS ocupacion,
    rol,
    document_id,
    VALOR_INGRESO_FINAL AS ingresos,
    propertyDelivery AS fecha_entrega_proyecto,
    financeValue AS valor_a_financiar,
    projectCity as ciudad_proyecto,
    projectName AS nombre_proyecto,
    propertyType AS tipo_vivienda,
    propertyValue as valor_vivienda,
    preselectaScore AS score,
    preselectaDecision,
    preselectaStatus,
    scoring,
    score_date,
    INGRESO_FINAL,
    ENDEUDAMIENTO,
    sarlaftStatus,
    identificationStatus,
    CUOTAS_TITULAR,
    housingLawIndicator,
    idFamilyGroup,
    -- BANDERA PARA EL FUNNEL EN LOOKER STUDIO
    IF(ROW_NUMBER() OVER(
      PARTITION BY identification 
      ORDER BY 
        IF(idFamilyGroup IS NOT NULL, 1, 0) DESC, createdAt DESC) = 1, 1, 0) AS es_intento_principal
  FROM ${ref("tbl_profiling")}
  -- Filtro incremental para no procesar todo siempre
  ${when(incremental(), `WHERE DATE(createdAt) >= CURRENT_DATE() - 3`)}
),

-- 2. Staging de la Calculadora Individual (PROTECCIÓN: Solo 1 fila por lead)
stg_calculator AS (
  SELECT
    id_lead, rango_salarios, rango_endeudamiento, rango_score, rango_credito_max_pesos_15,
    rango_credito_max_uvr_15, rango_credito_max_pesos_20, rango_credito_max_uvr_20,
    rango_credito_max_uvr_30, valor_credito, valor_credito_pesos_20_anios,
    valor_credito_uvr_20_anios, valor_credito_uvr_30_anios, credito_maximo_segun_disponible_pesos,
    credito_maximo_segun_disponible_uvr, endeudamiento
  FROM ${ref("firestore_calculator", "Calculator_table")}
  QUALIFY ROW_NUMBER() OVER(PARTITION BY id_lead ORDER BY timestamp_registro DESC) = 1
),

-- 3. Staging de la Calculadora Familiar (PROTECCIÓN: Solo 1 fila por Grupo Familiar)
stg_calculator_fam AS (
  SELECT
    idFamilyGroup, -- Llave de cruce correcta
    document_id, rango_salarios, rango_endeudamiento, rango_score, rango_credito_max_pesos_15,
    rango_credito_max_uvr_15, rango_credito_max_pesos_20, rango_credito_max_uvr_20,
    rango_credito_max_uvr_30, valor_credito, valor_credito_pesos_20_anios,
    valor_credito_uvr_20_anios, valor_credito_uvr_30_anios, credito_maximo_segun_disponible_pesos,
    credito_maximo_segun_disponible_uvr, calificacion, koggi_profiling, indicador_ley_vivienda, 
    ingresos, maximo_cuota_ley_vivienda, cuotas_titular, gastos_familiares
  FROM ${ref("src_calculator_fam")} 
  WHERE idFamilyGroup IS NOT NULL
  QUALIFY ROW_NUMBER() OVER(PARTITION BY idFamilyGroup ORDER BY timestamp_registro DESC) = 1
),

-- 4. Usuarios y Grupos Consolidados (Optimizado)
grupos_usuarios AS (
  SELECT u.email, u.entity_key, u.name AS usuario_nombre, g.name AS tipo_usuario, g.observation as observacion
  FROM ${ref("tbl_user")} u
  LEFT JOIN ${ref("tbl_groups")} g ON u.id_group = g.id
  QUALIFY ROW_NUMBER() OVER(PARTITION BY email, entity_key ORDER BY u.id) = 1
),

-- 5. Ensamble Final
quick_win_source_data AS (
  SELECT
    p.lead_id, p.identification, p.Fecha_creacion, p.createdEmail, p.fullname, 
    age.edad_promedio, p.gender, p.rol, p.ocupacion, 
    usr.usuario_nombre, usr.tipo_usuario, usr.observacion,
    p.idFamilyGroup, p.Constructora, p.nombre_proyecto, p.ciudad_proyecto, p.tipo_vivienda,
    p.valor_vivienda, p.fecha_entrega_proyecto, p.score, p.scoring,
    p.score_date, p.preselectaDecision, p.preselectaStatus,
    p.INGRESO_FINAL, p.ENDEUDAMIENTO, p.sarlaftStatus, 
    p.identificationStatus, p.venta_efectiva, p.valor_a_financiar,
    
    p.es_intento_principal,
    
    p.document_id,
    cfam.document_id AS fam_document_id, 
    p.calificacion_sugerida,
    COALESCE(cfam.calificacion, 'Sin Información') as fam_calificacion,
    p.housingLawIndicator,
    COALESCE(cfam.indicador_ley_vivienda, 'Sin Información') as fam_indicador_ley_vivienda,
    p.ingresos,
    cfam.ingresos AS fam_ingresos,         
    p.CUOTAS_TITULAR,
    cfam.cuotas_titular AS fam_cuotas_titular,

    COALESCE(c.rango_salarios, 'Sin Información') AS rango_salarios,
    COALESCE(cfam.rango_salarios, 'Sin Información') as fam_rango_salarios,        
    COALESCE(c.rango_endeudamiento, 'Sin Información') AS rango_endeudamiento,
    COALESCE(cfam.rango_endeudamiento, 'Sin Información') as fam_rango_endeudamiento,          
    COALESCE(c.rango_score, 'Sin Información') AS rango_score,
    COALESCE(cfam.rango_score, 'Sin Información') as fam_rango_score,

    COALESCE(c.rango_credito_max_pesos_15, 'Sin Información') AS rango_credito_max_pesos_15,
    COALESCE(cfam.rango_credito_max_pesos_15, 'Sin Información') as fam_rango_credito_max_pesos_15,
    COALESCE(c.rango_credito_max_uvr_15, 'Sin Información') AS rango_credito_max_uvr_15,
    COALESCE(cfam.rango_credito_max_uvr_15, 'Sin Información') AS fam_rango_credito_max_uvr_15,
    COALESCE(c.rango_credito_max_pesos_20, 'Sin Información') AS rango_credito_max_pesos_20,
    COALESCE(cfam.rango_credito_max_pesos_20, 'Sin Información') AS fam_rango_credito_max_pesos_20,
    COALESCE(c.rango_credito_max_uvr_20, 'Sin Información') AS rango_credito_max_uvr_20,
    COALESCE(cfam.rango_credito_max_uvr_20, 'Sin Información') AS fam_rango_credito_max_uvr_20,
    COALESCE(c.rango_credito_max_uvr_30, 'Sin Información') AS rango_credito_max_uvr_30,
    COALESCE(cfam.rango_credito_max_uvr_30, 'Sin Información') AS fam_rango_credito_max_uvr_30,

    c.valor_credito, 
    cfam.valor_credito AS fam_valor_credito, 
    c.valor_credito_pesos_20_anios, 
    cfam.valor_credito_pesos_20_anios AS fam_valor_credito_pesos_20_anios,
    c.valor_credito_uvr_20_anios,
    cfam.valor_credito_uvr_20_anios AS fam_valor_credito_uvr_20_anios, 
    c.valor_credito_uvr_30_anios, 
    cfam.valor_credito_uvr_30_anios AS fam_valor_credito_uvr_30_anios, 
    c.credito_maximo_segun_disponible_pesos,
    cfam.credito_maximo_segun_disponible_pesos AS fam_cred_max_segun_disp_pesos, 
    c.credito_maximo_segun_disponible_uvr,
    cfam.credito_maximo_segun_disponible_uvr AS fam_cred_max_segun_disp_uvr, 

    COALESCE(cfam.koggi_profiling, 'Sin Información') as fam_koggi_profiling,
    cfam.gastos_familiares AS fam_gastos_familiares,
    cfam.maximo_cuota_ley_vivienda AS fam_maximo_cuota_ley_vivienda,
    
    look.uid_entity AS uid_looker,
    
    IF(p.idFamilyGroup IS NOT NULL, 'GRUPO FAMILIAR', 'ÚNICO COMPRADOR') AS unidades_vivienda

  FROM stg_profiling AS p
  LEFT JOIN ${ref("stg_hdc_parsed_age")} AS age ON p.identification = age.identificacion
  LEFT JOIN stg_calculator AS c ON p.lead_id = c.id_lead
  LEFT JOIN stg_calculator_fam as cfam ON p.idFamilyGroup = cfam.idFamilyGroup
  LEFT JOIN grupos_usuarios AS usr ON p.createdEmail = usr.email AND p.Constructora = usr.entity_key
  LEFT JOIN ${ref("tbl_entity_database")} AS ent ON p.Constructora = ent.key
  LEFT JOIN ${ref("tbl_looker_board")} AS look ON ent.id_entity_database = look.entity_id
)

-- 6. Selección Final con protección contra duplicados en el MERGE
SELECT
  t.*,
  TO_HEX(MD5(TO_JSON_STRING(t))) AS fila_hash,
  CURRENT_DATETIME('America/Bogota') AS fecha_ultima_actualizacion_bi
FROM quick_win_source_data AS t
QUALIFY ROW_NUMBER() OVER(PARTITION BY lead_id ORDER BY Fecha_creacion DESC) = 1