config {
    type: "table",
    schema: "BI",
    name: "stg_hdc_parsed_age",
    description: "Tabla que extrae la edad más reciente por usuario.",
    assertions: {
        uniqueKey: ["identificacion"]
    }
}

WITH RankedHdc AS (
    SELECT
        user_identification_number AS identificacion,
        original_response,
        -- Orden por fecha descendente para que el registro más nuevo sea el número 1
        ROW_NUMBER() OVER(PARTITION BY user_identification_number ORDER BY hdc_date DESC) as rn
    FROM
        ${ref("tbl_sq_hdc_validity")}
    WHERE
        user_identification_number IS NOT NULL
),

ExtractedData AS (
    SELECT 
        identificacion,
        -- Extraccion edad mínima del JSON de forma segura
        COALESCE(
            SAFE_CAST(JSON_EXTRACT_SCALAR(original_response, '$.NaturalNacional.Edad.min') AS INT64),
            SAFE_CAST(JSON_EXTRACT_SCALAR(original_response, '$.NaturalNacional.Edad.attributes.min') AS INT64)
        ) AS edad_min,
        -- Extraccion edad máxima del JSON de forma segura
        COALESCE(
            SAFE_CAST(JSON_EXTRACT_SCALAR(original_response, '$.NaturalNacional.Edad.max') AS INT64),
            SAFE_CAST(JSON_EXTRACT_SCALAR(original_response, '$.NaturalNacional.Edad.attributes.max') AS INT64)
        ) AS edad_max
    FROM RankedHdc
    WHERE rn = 1 -- Filtro para quedarnos solo con el registro más reciente de cada identificacion
)

SELECT
    identificacion,
    edad_min, 
    edad_max, 
    -- Calcula el promedio y convertimos explícitamente a FLOAT64 (FLOAT)
    CAST(
        CASE 
            WHEN edad_min IS NOT NULL AND edad_max IS NOT NULL THEN (edad_min + edad_max) / 2
            WHEN edad_min IS NOT NULL THEN edad_min
            WHEN edad_max IS NOT NULL THEN edad_max
            ELSE NULL 
        END AS FLOAT64
    ) AS edad_promedio
FROM
    ExtractedData