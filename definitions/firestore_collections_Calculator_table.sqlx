config {
    type: "incremental",
    schema: "firestore_collections",
    name: "Calculator_table_TEST",
    description: "Tabla Calculadora Family Group V1. Versión TEST Incremental con columna de auditoría.",
    bigquery: {
        partitionBy: "fecha_registro",
        clusterBy: ["identificacion", "id_lead"]
    },
    uniqueKey: ["document_id"]
}

WITH
  calculator_data AS (
  SELECT
    document_id,
    created_at AS timestamp,
    data AS DATA
  FROM
    ${ref("FamilyGroupCalculator")}
    /* Filtro incremental basado en la columna created_at mapeada a timestamp */
    ${when(incremental(), `WHERE created_at > (SELECT MAX(timestamp) FROM ${self()})`)}
  ),
  
  PreCalculo AS (
  SELECT
    DATA,
    document_id,
    timestamp,
    SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.id_lead") AS INT64) AS id_lead,
    SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.identificacion") AS INT64) AS identificacion,
    COALESCE( 
      DATETIME(CAST(PARSE_DATETIME('%s', JSON_EXTRACT_SCALAR(DATA, "$.fecha_registro._seconds")) AS TIMESTAMP), "America/Bogota"), 
      DATETIME(TIMESTAMP(timestamp), "America/Bogota") 
    ) AS timestamp_registro_calculado
  FROM
    calculator_data 
  )

SELECT
  timestamp_registro_calculado AS timestamp_registro,
  document_id,
  timestamp,
  TRIM(LOWER(CONCAT(CAST(identificacion AS STRING), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.constructora") AS STRING)))) AS id_unico,
  id_lead,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_inmueble") AS INT64) AS valor_inmueble,
  JSON_EXTRACT_SCALAR(DATA, "$.calificacion") AS calificacion, 
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.personas_cargo") AS INT64) AS personas_cargo,
  TRIM(LOWER(JSON_EXTRACT_SCALAR(DATA, "$.proyecto"))) AS proyecto,
  TRIM(LOWER(JSON_EXTRACT_SCALAR(DATA, "$.constructora"))) AS constructora,
  JSON_EXTRACT_SCALAR(DATA, "$.koggi_profiling") AS koggi_profiling,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.score") AS INT64) AS score,
  identificacion,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.idFamilyGroup") AS INT64) AS idFamilyGroup,
  JSON_EXTRACT(DATA, "$.fecha_registro") AS fecha,
  JSON_EXTRACT_SCALAR(DATA, "$.tipo_vivienda") AS tipo_vivienda,
  JSON_EXTRACT_SCALAR(DATA, "$.nombre") AS nombre,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.diferencia_credito_maximo") AS INT64) AS diferencia_credito_maximo,
  JSON_EXTRACT_SCALAR(DATA, "$.indicador_ley_vivienda") AS indicador_ley_vivienda,
  JSON_EXTRACT_SCALAR(DATA, "$.indicador_causales") AS indicador_causales,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64) AS credito_maximo_segun_disponible_pesos,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64) AS credito_maximo_segun_disponible_uvr,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.disponible_cuota_segun_ingresos") AS INT64) AS disponible_cuota_segun_ingresos,
  JSON_EXTRACT_SCALAR(DATA, "$.projectBankNIT") AS projectBankNIT,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) AS ingresos,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.maximo_cuota_ley_vivienda") AS INT64) AS maximo_cuota_ley_vivienda,
  JSON_EXTRACT_SCALAR(DATA, "$.ciudad") AS ciudad,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuotas_titular") AS INT64) AS cuotas_titular,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.gastos_familiares") AS INT64) AS gastos_familiares,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64) AS valor_credito,
  FALSE AS es_followup_origen,
  'FAMILY_GROUP' AS tipo_registro_origen,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64)) AS valor_credito_pesos_20_anios,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) AS valor_credito_uvr_20_anios,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[4].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) AS valor_credito_uvr_30_anios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[0].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64) AS prestamo_maximo_tasa_mediana_15_anios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[1].tasa_baja.prestamo_maximo_segun_disponible") AS INT64) AS prestamo_maximo_tasa_baja_15_anios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[3].tasa_baja.prestamo_maximo_segun_disponible") AS INT64) AS prestamo_maximo_tasa_baja_20_anios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[4].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64) AS prestamo_maximo_tasa_mediana_30_anios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[5].tasa_baja.prestamo_maximo_segun_disponible") AS INT64) AS prestamo_maximo_tasa_baja_30_anios,
  DATE(timestamp_registro_calculado) AS fecha_registro,
  FORMAT_TIMESTAMP("%Y-%m", timestamp_registro_calculado) AS mes_registro,
  CASE
    WHEN LOWER(TRIM(JSON_EXTRACT_SCALAR(DATA, "$.ciudad"))) = 'bogotá, d.c.' THEN 'BOGOTA'
    ELSE UPPER(TRIM(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(JSON_EXTRACT_SCALAR(DATA, "$.ciudad"), 'Á', 'A'), 'É', 'E'), 'Í', 'I'), 'Ó', 'O'), 'Ú', 'U'), 'á', 'a'), 'é', 'e'), 'í', 'i'), 'ó', 'o'), 'ú', 'u')))
  END AS ciudad_estandarizada,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuotas_titular") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64), 0) AS endeudamiento,
  CASE
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuotas_titular") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64), 0)) <= 0.3 THEN '≤ 30%'
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuotas_titular") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64), 0)) <= 0.6 THEN '31% a 60%'
    ELSE '≥ 61%'
  END AS rango_endeudamiento,
  CASE
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.score") AS INT64) <= 500 THEN '≤ 500'
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.score") AS INT64) BETWEEN 501 AND 650 THEN '≥ 501 y < 650'
    ELSE '≥ 651'
  END AS rango_score,
  CASE
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) <= 1400000 THEN '≤ 1'
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) <= 2800000 THEN '1 a 2'
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) <= 5600000 THEN '2 a 4'
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) <= 8400000 THEN '4 a 6'
    WHEN SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.ingresos") AS INT64) <= 14000000 THEN '7 a 10'
    ELSE 'Más de 10'
  END AS rango_salarios,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0) AS credito_max_pesos,
  CASE
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) <= 0.7 THEN '≤ 70%'
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) < 0.95 THEN '70% a 95%'
    ELSE '≥ 95%'
  END AS rango_credito_max_pesos_15,
  SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0) AS credito_max_uvr,
  CASE
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) <= 0.7 THEN '≤ 70%'
    WHEN (SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) < 0.95 THEN '70% a 95%'
    ELSE '≥ 95%'
  END AS rango_credito_max_uvr_15,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0) AS credito_max_pesos_20,
  CASE
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) <= 0.7 THEN '≤ 70%'
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_pesos[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_pesos") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) < 0.95 THEN '70% a 95%'
    ELSE '≥ 95%'
  END AS rango_credito_max_pesos_20,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0) AS credito_max_uvr_20,
  CASE
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) <= 0.7 THEN '≤ 70%'
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[2].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) < 0.95 THEN '70% a 95%'
    ELSE '≥ 95%'
  END AS rango_credito_max_uvr_20,
  COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[4].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0) AS credito_max_uvr_30,
  CASE
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[4].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) <= 0.7 THEN '≤ 70%'
    WHEN (COALESCE(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.cuota_uvr[4].tasa_mediana.prestamo_maximo_segun_disponible") AS INT64), SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.credito_maximo_segun_disponible_uvr") AS INT64)) / NULLIF(SAFE_CAST(JSON_EXTRACT_SCALAR(DATA, "$.valor_credito") AS INT64), 0)) < 0.95 THEN '70% a 95%'
    ELSE '≥ 95%'
  END AS rango_credito_max_uvr_30,
  CURRENT_DATE() AS ultima_actualizacion
FROM
  PreCalculo